# Dependencies
node_modules/

# Build outputs
dist/
todo-app/dist/
# todo-app/build/ holds electron-builder *source* assets (app icon), not output.
# Ignore anything generated there but keep the icon tracked so CI builds use it
# instead of falling back to the default Electron icon.
todo-app/build/*
!todo-app/build/icon.ico

# Local user data (todo storage)
todo-app/data/

# Logs
logs/
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude / MoAI tooling / local state
.claude/
.moai/

# Backups & temp
*.bak
*.tmp

# Memory dumps from crashes (kept locally for debugging, never committed)
*.DMP
*.dmp
